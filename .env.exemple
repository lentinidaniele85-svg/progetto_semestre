# OpenRouter è l'unico provider LLM supportato.
# Copia questo file come .env e compila i valori.
LLM_PROVIDER=openrouter

# Chiave API OpenRouter (ottienila su https://openrouter.ai)
OPENROUTER_API_KEY=tua chiave

# Modello da usare tramite OpenRouter
OPENROUTER_MODEL=openai/gpt-4o-mini

# Fonte dati LCA: "csv" (DataSet.xlsx locale) o "ecoinvent_api" (futuro)
LCA_DATA_SOURCE=csv

# Pesi MCDA — solo CO₂ e costo sono supportati (dataset contiene solo climateChangeImpact)
WEIGHT_CO2=0.70
WEIGHT_COST=0.30
WEIGHT_ENERGY=0.0
WEIGHT_WATER=0.0
